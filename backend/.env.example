# Copy to .env and fill in. Never commit .env.

ENV=development
DEBUG=true

# Database (use postgresql+asyncpg://... for asyncpg driver)
DATABASE_URL=postgresql+asyncpg://parkour:parkour@localhost:5432/parkour

# Redis (chat pub/sub, rate limiting cache)
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# CORS — comma-separated origins for the mobile/web clients
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Object storage for spot photos (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=parkour-spots
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Initial admin user, created on first migration if not exists
INITIAL_ADMIN_EMAIL=admin@notot.family
INITIAL_ADMIN_PASSWORD=

# Outbound email — verification codes and instructor dossiers.
# console = print to the log (dev), memory = keep in a list (tests),
# smtp = actually send. Production refuses to start on anything but smtp.
MAIL_BACKEND=console
# Sender of every automated message. Nobody reads replies to it: the body
# always points people at MODERATION_EMAIL instead.
MAIL_FROM=noreply@notot.family
MAIL_FROM_NAME=PkFAMILY
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# The mailbox that already reviews spots. Instructor certificates and the
# identity documents that go with them are forwarded here for manual checking.
# Falls back to INITIAL_ADMIN_EMAIL when empty.
MODERATION_EMAIL=

# Email sign-in codes
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_MAX_PER_HOUR=5
EMAIL_CODE_MIN_INTERVAL_SECONDS=60
