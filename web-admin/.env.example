# Console di moderazione — configurazione
#
# Entrambe le variabili sono pubbliche per costruzione (finiscono nel bundle
# servito al browser). Va bene: la publishable key lavora sotto RLS.
#
# La SECRET KEY non va MAI messa qui né in nessun file di questa cartella:
# bypassa ogni policy RLS. Se ti serve un'operazione privilegiata, passa da una
# Supabase Edge Function che verifica il ruolo lato server.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
