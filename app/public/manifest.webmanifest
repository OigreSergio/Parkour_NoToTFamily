{
  "id": "/pkfamily-app/",
  "name": "PkFAMILY — spot di parkour",
  "short_name": "PkFAMILY",
  "description": "La mappa degli spot di parkour, i tutorial e la famiglia. Funziona anche senza rete.",
  "lang": "it",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#F4ECE0",
  "theme_color": "#C26A52",
  "categories": ["sports", "navigation", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Mappa", "url": "./index.html#/mappa", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Spot vicini", "url": "./index.html#/spot", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tutorial", "url": "./index.html#/tutorial", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
