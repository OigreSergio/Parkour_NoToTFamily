# Copia questo file in `.env` e compila. Il file `.env` NON va mai committato
# (è nel .gitignore): in remoto le stesse variabili si impostano nel pannello
# del provider o nei "secrets" di GitHub, mai in un file nel repository.
#
# Ogni variabile qui corrisponde a un campo di `pkremote/config.py`, che
# spiega anche i controlli che scattano quando ENV=production.

# --- Identità dell'ambiente ---------------------------------------------------
# development | test | production. In production alcune scelte sono obbligate.
ENV=development
DEBUG=false
# Nome libero che compare nei log e in /healthz (utile con più istanze).
INSTANCE_NAME=locale

# --- Rete -----------------------------------------------------------------------
# In locale 127.0.0.1 basta. In remoto (container) DEVE essere 0.0.0.0, altrimenti
# il traffico del provider non arriva al processo: è l'errore più comune.
HOST=127.0.0.1
# Molti provider impongono la porta con la variabile PORT: viene letta così com'è.
PORT=8080
# Origini del browser autorizzate (CORS), separate da virgola. In production
# non può essere vuota né contenere "*".
CORS_ORIGINS=http://localhost:8080,https://oigresergio.github.io
# Il provider termina TLS e passa X-Forwarded-*: true per fidarsi di quelle intestazioni,
# ma solo se arrivano dagli indirizzi in FORWARDED_ALLOW_IPS (in locale il proxy sulla
# stessa macchina; su un PaaS dove il container è raggiungibile solo dal proxy: *).
PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Supabase (backend di produzione: masterplan cap. 4.2) ---------------------
# URL del progetto, es. https://<ref>.supabase.co
SUPABASE_URL=
# Chiave "publishable" del pannello Supabase (Settings → API Keys): pensata per i
# client, le RLS restano attive. È l'unica che il servizio usa per leggere.
SUPABASE_PUBLISHABLE_KEY=
# Chiave "secret" dello stesso pannello: scavalca le RLS. Oggi nessun job la usa;
# resta prevista per i job privilegiati futuri. Mai in un client, mai nei log, mai
# nel repository. Da sola NON attiva le letture.
SUPABASE_SECRET_KEY=
# Tempo massimo (secondi) per ogni chiamata HTTP in uscita, e per i controlli di /readyz.
HTTP_TIMEOUT_SECONDS=10
READY_TIMEOUT_SECONDS=3

# --- Percorsi (proxy verso OSRM, docs/ROUTING_PK.md fase 2) -------------------
# Vuoto = proxy disattivato: /api/v1/route risponde 503 e il client usa il fallback.
# Con `docker compose --profile routing up` diventa http://osrm:5000.
OSRM_BASE_URL=
OSRM_PROFILE=foot
# Cache delle risposte: durata e numero massimo di voci in memoria.
ROUTE_CACHE_TTL_SECONDS=3600
ROUTE_CACHE_MAX_ENTRIES=5000
# Cifre decimali tenute nelle coordinate prima di usarle: 3 = circa 111 metri.
# È la misura di privacy del masterplan (cap. 6.4): il servizio non vede mai
# la posizione esatta di una persona.
COORDINATE_DECIMALS=3

# --- Job -------------------------------------------------------------------------
# Token per lanciare i job via HTTP (POST /api/v1/jobs/<nome>). Vuoto = i job si
# lanciano solo dalla riga di comando (`pkremote job <nome>`).
# Generalo con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JOB_TOKEN=
# Cartella in cui i job scrivono i loro risultati.
JOBS_OUTPUT_DIR=./output

# --- Log ------------------------------------------------------------------------
# json (per il remoto: i provider lo indicizzano) | console (leggibile a occhio).
LOG_FORMAT=console
